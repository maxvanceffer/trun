{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "qt-docs": {
      "type": "remote",
      "url": "https://qt-docs-mcp.qt.io/mcp"
    },
    "servers": {
      "nuxt-ui": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "mcp-remote",
          "https://ui.nuxt.com/mcp"
        ]
      }
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/**": "allow"
    }
  }
}
